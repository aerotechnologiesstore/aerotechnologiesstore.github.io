rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /icons/{devId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == devId;
    }
    match /banners/{devId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == devId;
    }
    match /verifications/{devId}/{allPaths=**} {
      allow read: if request.auth != null; // Admin verification
      allow write: if request.auth != null && request.auth.uid == devId;
    }
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; 
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
